# Copy to .env and replace every value. Consumed by: docker compose (containers),
# dbt (auto-loads this file), and local_parsing/config.py (via python-dotenv).
# A real env var already set in the shell overrides anything here.
#
# The defaults shown are the LOCAL DOCKER STACK. For another environment
# (shared Oracle, the bank's Lakekeeper, a Spark cluster) override the values
# in each section below -- no code change needed.

# ─────────────────────────────── Oracle ─────────────────────────────── #
ORACLE_PASSWORD=change-this-oracle-admin-password
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
# Schema/user that OWNS the source tables. In the local stack
# init-scripts/00_setup.sh creates it, loads the fixture into it, and GRANTs
# SELECT on it to PUBLIC. Elsewhere: point at the schema that already owns them.
ORACLE_SCHEMA=source_table
ORACLE_SCHEMA_PASSWORD=change-this-source-schema-password
# Identity Trino + local_parsing connect as. "system" (admin) works out of the
# box; a dedicated name is created by 00_setup.sh (local stack only) and reads
# via the PUBLIC grant. Leave blank-owner handling to ORACLE_SCHEMA.
ORACLE_APP_USER=system
ORACLE_APP_PASSWORD=change-this-application-password

# ──────────────────── Object store + Iceberg catalog ────────────────── #
MINIO_ROOT_USER=replace-with-access-key
MINIO_ROOT_PASSWORD=replace-with-secret-key-at-least-8-characters
MINIO_ENDPOINT=http://localhost:9000    # S3 endpoint (also honoured as S3_ENDPOINT)
AWS_REGION=us-east-1                     # also honoured as S3_REGION
ICEBERG_REST_URI=http://localhost:8181   # the bank's Lakekeeper URL in prod
ICEBERG_WAREHOUSE=s3://warehouse/
# Postgres backing the Iceberg REST catalog (service: iceberg-catalog-db).
# OPTIONAL -- omit to use these exact defaults. Host port is 5433:
#   psql "postgresql://iceberg:iceberg@localhost:5433/iceberg_catalog"
ICEBERG_CATALOG_DB_USER=iceberg
ICEBERG_CATALOG_DB_PASSWORD=iceberg
ICEBERG_CATALOG_DB_NAME=iceberg_catalog

# ───────────────────────── dbt (host-side) ─────────────────────────── #
TRINO_HOST=localhost
TRINO_PORT=8080

# ───────────────────── Spark - local_parsing ─────────────────────── #
# Both DAILY and HISTORY run on this one machine (local[2] / local[*]) --
# no cluster wiring here. See local_parsing/.claude/skills/
# local-parsing-requirements/SKILL.md, Requirement 1, for why.
#   SPARK_LOCAL_IP       - driver address; 127.0.0.1 dodges a slow Windows lookup
#   PYSPARK_SUBMIT_ARGS  - driver JVM heap; keep the trailing 'pyspark-shell'
SPARK_LOCAL_IP=127.0.0.1
PYSPARK_SUBMIT_ARGS=--driver-memory 4g pyspark-shell
# HISTORY job only -- DAILY is always local[2] and needs none of it.
SPARK_JDBC_NUM_PARTITIONS=16
