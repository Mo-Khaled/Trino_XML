# Copy this file to .env and replace every value before starting the stack.
ORACLE_PASSWORD=change-this-oracle-admin-password
ORACLE_APP_USER=bronze_user
ORACLE_APP_PASSWORD=change-this-application-password
MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-minio-secret-key-at-least-8-characters
